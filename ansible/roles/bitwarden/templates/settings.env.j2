# {{ ansible_managed }}
BW_DOMAIN={{ bitwarden_domain | replace('$', '$$') | to_json(ensure_ascii=false) }}
BW_DB_PROVIDER=sqlite
BW_INSTALLATION_ID={{ bitwarden_installation_id | replace('$', '$$') | to_json(ensure_ascii=false) }}
BW_INSTALLATION_KEY={{ bitwarden_installation_key | replace('$', '$$') | to_json(ensure_ascii=false) }}
BW_ENABLE_SSL=true
BW_SSL_CERT=ssl.crt
BW_SSL_KEY=ssl.key
BW_PORT_HTTP={{ bitwarden_http_port | int }}
BW_PORT_HTTPS={{ bitwarden_https_port | int }}
{% if bitwarden_https_port | int != 443 %}
globalSettings__baseServiceUri__vault={{ ('https://' ~ bitwarden_domain ~ ':' ~ bitwarden_https_port) | replace('$', '$$') | to_json(ensure_ascii=false) }}
{% endif %}
{% if bitwarden_smtp_host | length > 0 %}
globalSettings__mail__smtp__host={{ bitwarden_smtp_host | replace('$', '$$') | to_json(ensure_ascii=false) }}
globalSettings__mail__smtp__port={{ bitwarden_smtp_port | string | replace('$', '$$') | to_json(ensure_ascii=false) }}
globalSettings__mail__smtp__ssl={{ bitwarden_smtp_ssl | bool | ternary('true', 'false') }}
globalSettings__mail__smtp__username={{ bitwarden_smtp_username | replace('$', '$$') | to_json(ensure_ascii=false) }}
globalSettings__mail__smtp__password={{ bitwarden_smtp_password | replace('$', '$$') | to_json(ensure_ascii=false) }}
globalSettings__mail__replyToEmail={{ bitwarden_smtp_reply_to | replace('$', '$$') | to_json(ensure_ascii=false) }}
{% endif %}
