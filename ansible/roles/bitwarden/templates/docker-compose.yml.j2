# {{ ansible_managed }}
services:
  bitwarden:
    image: {{ bitwarden_image | to_json }}
    env_file:
      - settings.env
    user: "{{ bitwarden_uid }}:{{ bitwarden_gid }}"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    sysctls:
      net.ipv4.ip_unprivileged_port_start: 0
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=768m
    ports:
      - "{{ bitwarden_http_port }}:{{ bitwarden_http_port }}"
      - "{{ bitwarden_https_port }}:{{ bitwarden_https_port }}"
    volumes:
      - ./data:/etc/bitwarden
      - ./logs:/var/log/bitwarden
      - ./backups:/backups
    restart: unless-stopped
