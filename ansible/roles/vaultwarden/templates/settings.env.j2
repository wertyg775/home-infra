# {{ ansible_managed }}
DOMAIN={{ ('https://' ~ vaultwarden_domain ~ ((':' ~ vaultwarden_https_port) if vaultwarden_https_port | int != 443 else '')) | replace('$', '$$') | to_json }}
DATA_FOLDER="/data"
ROCKET_ADDRESS="0.0.0.0"
ROCKET_PORT="8080"
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | bool | ternary('true', 'false') }}
PUSH_ENABLED=false
{% if vaultwarden_smtp_host | length > 0 %}
SMTP_HOST={{ vaultwarden_smtp_host | replace('$', '$$') | to_json(ensure_ascii=false) }}
SMTP_FROM={{ vaultwarden_smtp_from | replace('$', '$$') | to_json(ensure_ascii=false) }}
SMTP_PORT={{ vaultwarden_smtp_port | string | to_json }}
SMTP_SECURITY={{ vaultwarden_smtp_security | to_json }}
{% if vaultwarden_smtp_username | length > 0 %}
SMTP_USERNAME={{ vaultwarden_smtp_username | replace('$', '$$') | to_json(ensure_ascii=false) }}
{% endif %}
{% if vaultwarden_smtp_password | length > 0 %}
SMTP_PASSWORD={{ vaultwarden_smtp_password | replace('$', '$$') | to_json(ensure_ascii=false) }}
{% endif %}
{% endif %}
