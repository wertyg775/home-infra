#!/usr/bin/python3
"""Submit trusted local commands as transient systemd user services."""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import uuid

ROOT = Path.home() / '.local/state/gpu-run'
ID_RE = re.compile(r'job-[0-9]{8}T[0-9]{6}-[0-9a-f]{12}')


def now():
    return datetime.now(timezone.utc).isoformat()


def save(path, value):
    temp = path.with_suffix('.tmp')
    temp.write_text(json.dumps(value, indent=2) + '\n')
    temp.replace(path)


def job_path(job_id):
    if not ID_RE.fullmatch(job_id):
        raise ValueError('Invalid job ID')
    path = ROOT / 'jobs' / job_id
    if not (path / 'job.json').is_file():
        raise ValueError('Unknown job ID')
    return path


def unit(job_id):
    return f'gpu-run-{job_id}.service'


def query(command):
    return subprocess.check_output(command, text=True, stderr=subprocess.PIPE).strip()


def submit(args):
    project = args.project.expanduser().resolve(strict=True)
    if not project.is_dir():
        raise ValueError('Project must be a directory')
    command = args.command
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        raise ValueError('Supply a command after --')
    executable = command[0]
    if '/' in executable:
        executable = str((project / executable).absolute())
    else:
        executable = shutil.which(executable)
    if not executable or not os.access(executable, os.X_OK):
        raise ValueError('Command executable is missing or not executable')
    # Do not resolve venv Python symlinks: that would bypass the venv.
    command = [executable, *command[1:]]
    gpu = query(['nvidia-smi', '-i', args.gpu, '--query-gpu=uuid', '--format=csv,noheader'])
    if not re.fullmatch(r'GPU-[a-fA-F0-9-]+', gpu):
        raise ValueError('Select one physical NVIDIA GPU by index or UUID')
    linger = query(['loginctl', 'show-user', str(os.getuid()), '-p', 'Linger', '--value'])
    if linger != 'yes':
        raise ValueError('Enable linger first: sudo loginctl enable-linger YOUR_USER')
    # A query also works when the manager reports "degraded".
    query(['systemctl', '--user', 'show-environment'])
    job_id = 'job-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S') + '-' + uuid.uuid4().hex[:12]
    path = ROOT / 'jobs' / job_id
    path.mkdir(parents=True, mode=0o700)
    (path / 'output').mkdir(mode=0o700)
    (path / 'train.log').touch(mode=0o600)
    try:
        revision = query(['git', '-C', str(project), 'rev-parse', 'HEAD'])
        dirty = bool(query(['git', '-C', str(project), 'status', '--porcelain']))
    except subprocess.CalledProcessError:
        revision, dirty = None, None
    metadata = dict(id=job_id, submitted=now(), project=str(project), command=command,
                    gpu=gpu, revision=revision, dirty=dirty)
    save(path / 'job.json', metadata)
    # Preserve dependency manifests and the exact worker used for this submission.
    for name in ('pyproject.toml', 'uv.lock', '.python-version'):
        if (project / name).is_file():
            shutil.copyfile(project / name, path / name)
    shutil.copyfile(Path(__file__).resolve(), path / 'worker.py')
    run = ['systemd-run', '--user', '--quiet', '--collect', '--service-type=exec',
           '--unit=' + unit(job_id), '--property=Restart=no',
           '--property=KillMode=control-group', '--property=TimeoutStopSec=30s',
           '--property=UMask=0077', '--property=Nice=10', '--property=CPUWeight=20',
           '--property=IOWeight=20', '--property=NoNewPrivileges=yes',
           '/usr/bin/python3', str(path / 'worker.py'), '_worker', job_id]
    result = subprocess.run(run)
    if result.returncode:
        save(path / 'result.json', dict(state='submission_failed', ended=now(), exit_code=result.returncode))
        print(f'Submission failed: {job_id}; inspect the systemd error above', file=sys.stderr)
        return result.returncode
    print(job_id)
    print(f'Logs: {path / "train.log"}')
    print(f'Output: {path / "output"}')
    return 0


def worker(job_id):
    path = job_path(job_id)
    metadata = json.loads((path / 'job.json').read_text())
    lock_dir = ROOT / 'locks'
    lock_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (lock_dir / (metadata['gpu'] + '.lock')).open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            save(path / 'result.json', dict(state='gpu_busy', ended=now(), exit_code=75))
            return 75
        state = dict(state='running', started=now())
        save(path / 'result.json', state)
        environment = os.environ.copy()
        environment.update(CUDA_VISIBLE_DEVICES=metadata['gpu'], PYTHONUNBUFFERED='1',
                           GPU_JOB_ID=job_id, GPU_JOB_OUTPUT_DIR=str(path / 'output'))
        stopped = []
        process = None

        def stop(signum, frame):
            stopped.append(signum)
            if process is not None:
                try:
                    os.killpg(process.pid, signum)
                except ProcessLookupError:
                    pass

        previous = {s: signal.signal(s, stop) for s in (signal.SIGTERM, signal.SIGINT)}
        try:
            with (path / 'train.log').open('ab', buffering=0) as log:
                try:
                    if stopped:
                        code = 128 + stopped[0]
                    else:
                        process = subprocess.Popen(metadata['command'], cwd=metadata['project'],
                                                   env=environment, stdout=log, stderr=subprocess.STDOUT,
                                                   stdin=subprocess.DEVNULL, start_new_session=True)
                        if stopped:
                            stop(stopped[0], None)
                        code = process.wait()
                        if code < 0:
                            code = 128 - code
                    outcome = 'cancelled' if stopped else ('succeeded' if code == 0 else 'failed')
                except OSError as error:
                    log.write((str(error) + '\n').encode())
                    code, outcome = 127, 'failed'
            state.update(state=outcome, ended=now(), exit_code=code)
            save(path / 'result.json', state)
            return code
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def status(job_id):
    path = job_path(job_id)
    print((path / 'job.json').read_text(), end='')
    result = path / 'result.json'
    print(result.read_text() if result.exists() else 'No worker result recorded yet')
    # Saved worker status can be stale after SIGKILL or reboot; show both.
    subprocess.run(['systemctl', '--user', 'show', unit(job_id),
                    '-p', 'LoadState', '-p', 'ActiveState', '-p', 'SubState',
                    '-p', 'Result', '-p', 'ExecMainStatus'])


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    submit_parser = commands.add_parser('submit', help='Run a command in its prepared project')
    submit_parser.add_argument('--project', required=True, type=Path)
    submit_parser.add_argument('--gpu', default='0', help='Physical NVIDIA index or GPU UUID')
    submit_parser.add_argument('command', nargs=argparse.REMAINDER)
    commands.add_parser('list', help='List saved jobs; use status to check live unit state')
    for name in ('status', 'stop', '_worker'):
        commands.add_parser(name).add_argument('id')
    logs = commands.add_parser('logs')
    logs.add_argument('id')
    logs.add_argument('-f', '--follow', action='store_true')
    args = parser.parse_args()
    if args.action == 'submit':
        return submit(args)
    if args.action == 'list':
        for path in sorted((ROOT / 'jobs').glob('job-*'), reverse=True):
            result = path / 'result.json'
            state = json.loads(result.read_text())['state'] if result.exists() else 'submitted'
            print(path.name, state)
        return 0
    path = job_path(args.id)
    if args.action == '_worker':
        return worker(args.id)
    if args.action == 'status':
        status(args.id)
        return 0
    if args.action == 'logs':
        return subprocess.call(['tail', '-n', '100', *(['-f'] if args.follow else []), str(path / 'train.log')])
    return subprocess.call(['systemctl', '--user', 'stop', unit(args.id)])


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'gpu-run: {error}', file=sys.stderr)
        sys.exit(1)
