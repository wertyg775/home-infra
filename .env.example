# Copy this file to .env and fill in your environment-specific values.
# .env is gitignored and never committed.
# Load into your shell before running Ansible or Terraform:
#   source scripts/env.sh

# General
HOMELAB_USER=admin
HOMELAB_TIMEZONE=UTC
HOMELAB_LAN_CIDR=192.0.2.0/24
HOMELAB_LAN_PREFIX_LEN=24
HOMELAB_LAN_GATEWAY=192.0.2.1
HOMELAB_ADMIN_IP=192.0.2.10

# Proxmox host
PROXMOX_NODE=pve1
PROXMOX_HOST=192.0.2.2
PROXMOX_SSH_KEY=~/.ssh/proxmox_node
# Optional: bpg/proxmox Terraform provider credentials (exported automatically)
# PROXMOX_VE_API_TOKEN=user@pve!token-id=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Arr / Docker VM
ARR_HOST=192.0.2.101
ARR_MAC=BC:24:11:00:00:01
ARR_SSH_KEY=~/.ssh/container_vm

# Vaultwarden VM
VAULTWARDEN_HOST=192.0.2.102
VAULTWARDEN_MAC=BC:24:11:00:00:02
VAULTWARDEN_SSH_KEY=~/.ssh/homelab_guest
VAULTWARDEN_CA_CERT=~/.local/share/homelab-ca/ca.crt
VAULTWARDEN_CA_KEY=~/.local/share/homelab-ca/ca.key

# Nginx reverse proxy LXC
NGINX_PROXY_HOST=192.0.2.103
NGINX_PROXY_SSH_KEY=~/.ssh/homelab_guest

# Pi-hole LXC
PIHOLE_HOST=192.0.2.104
PIHOLE_SSH_KEY=~/.ssh/homelab_guest

# Tailscale / Nextcloud host
TAILSCALE_IP=100.64.0.1
